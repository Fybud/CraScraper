# Paste into Deploy UI → CraScraper → Environment → Raw.
# Do NOT add: API_HOST_PORT, WEB_HOST_PORT, IMAGE_TAG.
# RABBITMQ_URL empty disables collection if your app treats it that way.

PORT=4000
NODE_ENV=production
JWT_SECRET=dev-jwt-secret-change-me
SEED_EMAIL=agency@fiberai.com
SEED_PASSWORD=password123
TARGET_QUALIFIED=100
STALE_AFTER_HOURS=168
RABBITMQ_URL=
DATABASE_URL=postgresql://postgres:postgres@fybud-postgres:5432/crascraper
CORS_ORIGIN=https://crascraper.fybud.com,https://api.crascraper.fybud.com
