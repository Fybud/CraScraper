DATABASE_URL=postgres://postgres:postgres@localhost:5432/crascraper
RABBITMQ_URL=amqp://rabbit:rabbit@localhost:5672
COLLECTOR_MODE=public
SCRAPE_JOBS_QUEUE=scrape.jobs
SCRAPE_POSTS_QUEUE=scrape.posts
PLAYWRIGHT_TIMEOUT_MS=20000
MIN_FOLLOWERS=1000
RECENT_CONTENT_DAYS=180
POLITE_DELAY_SECONDS=3
SEED_CSV_PATH=app/seeds/instagram_profiles.csv
TARGET_QUALIFIED=100
MAX_FOLLOWING_CANDIDATES=80
MAX_FOLLOWER_CANDIDATES=40
DISCOVER_BATCH_SIZE=20